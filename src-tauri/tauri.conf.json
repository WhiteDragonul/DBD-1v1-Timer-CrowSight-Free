{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrowSight - 1v1 Timer",
  "mainBinaryName": "CrowSight - 1v1 Timer",
  "version": "1.3.0",
  "identifier": "app.crowsight.onevonetimer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrowSight - 1v1 Timer",
        "url": "/",
        "width": 620,
        "height": 900,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "White & Feint",
    "shortDescription": "Free 1v1 match timer overlay",
    "longDescription": "CrowSight - 1v1 Timer - a free standalone match timer overlay with three presets, global hotkeys, and automatic scoring. No account required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMUE0QjFGQzk4NjMzNUUKUldSZU00YkpIMHNhMGRnZ2ZtUmpTMXZBdjZMTWpIdTNxaVhmQlNoQVpRZHk0OFFSaG1qRzVVNzIK",
      "endpoints": [
        "https://github.com/WhiteDragonul/DBD-1v1-Timer-CrowSight-Free/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
